{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "project": "constella",
  "version": "1.0.0-rc",
  "description": "Universal deployment configuration for Constella. Fill this file and provide it to any AI agent or deployment pipeline.",
  "infrastructure": {
    "frontend_hosting": "vercel",
    "backend_hosting": "railway_or_render_or_vps",
    "database_provider": "aiven_postgres_postgis",
    "storage_provider": "cloudflare_r2",
    "email_provider": "resend_or_brevo_smtp",
    "monitoring_provider": "sentry"
  },
  "telegram": {
    "bot_token": "YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER",
    "bot_username": "YOUR_BOT_USERNAME",
    "admin_telegram_ids": [
      "123456789"
    ]
  },
  "database": {
    "provider": "aiven",
    "database_url": "postgres://avnadmin:YOUR_PASSWORD@YOUR_AIVEN_HOST:PORT/defaultdb?sslmode=require",
    "pool_size": 10,
    "require_postgis": true
  },
  "storage": {
    "provider": "cloudflare_r2",
    "photo_bucket": "constella-media",
    "s3_endpoint": "https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com",
    "s3_region": "auto",
    "s3_access_key_id": "YOUR_R2_ACCESS_KEY_ID",
    "s3_secret_access_key": "YOUR_R2_SECRET_ACCESS_KEY",
    "s3_public_base_url": "https://pub-xxxxxx.r2.dev",
    "s3_force_path_style": false
  },
  "monitoring": {
    "sentry_dsn_backend": "https://PUBLIC_KEY@oORG_ID.ingest.sentry.io/API_PROJECT_ID",
    "sentry_dsn_frontend": "https://PUBLIC_KEY@oORG_ID.ingest.sentry.io/WEB_PROJECT_ID",
    "environment": "production"
  },
  "email": {
    "provider": "resend",
    "smtp_host": "smtp.resend.com",
    "smtp_port": 587,
    "smtp_secure": false,
    "smtp_user": "resend",
    "smtp_password": "re_YOUR_RESEND_API_KEY",
    "smtp_from": "Constella Support <support@yourdomain.com>"
  },
  "security": {
    "jwt_secret": "GENERATE_RANDOM_32_CHAR_STRING",
    "payments_internal_token": "GENERATE_RANDOM_32_CHAR_STRING",
    "rate_limit_max": 120
  },
  "urls": {
    "frontend_web_app_url": "https://constella.vercel.app",
    "backend_api_url": "https://constella-api.up.railway.app",
    "api_public_url": "/api"
  },
  "vercel": {
    "vercel_token": "YOUR_VERCEL_CLI_TOKEN_OPTIONAL",
    "project_name": "constella-web",
    "framework": "nuxtjs",
    "root_directory": "apps/web"
  }
}
