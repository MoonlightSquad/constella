# Local development defaults. Replace every placeholder before deployment.
DATABASE_URL=postgres://constella:constella_secret_password@localhost:5432/constella
POSTGRES_PASSWORD=constella_secret_password
BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-api-domain.example/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-32-character-webhook-secret
JWT_SECRET=replace-with-at-least-32-random-characters
PAYMENTS_INTERNAL_TOKEN=replace-with-a-different-random-secret-of-at-least-32-characters
WEB_APP_URL=https://your-public-https-domain.example
API_INTERNAL_URL=http://127.0.0.1:4000
NUXT_API_INTERNAL_BASE=http://127.0.0.1:4000
# Landing site (apps/landing, dev server on :5174). Canonical host used for
# prerendered markup, hreflang, sitemap and RSS — replace with the real domain
# for any deployment; the deploy scripts ignore a localhost value here on purpose.
NUXT_PUBLIC_SITE_URL=http://localhost:5174
# t.me/<bot> username used by the landing and web calls to action.
NUXT_PUBLIC_BOT_USERNAME=replace-with-your-bot-username
# Admin console (apps/admin, dev server on :5175, deployed as its own Vercel project).
# It talks to the API only through its own nitro server (NUXT_API_INTERNAL_BASE above),
# never from the browser, so the API's single-origin CORS allowlist does not apply to it.
# ADMIN_APP_URL is the console's own origin: used by the deploy scripts for the Vercel
# domain and by R2 CORS, so blog cover uploads from the console are not blocked.
ADMIN_APP_URL=https://admin.your-domain.example
PORT=4000
LOG_LEVEL=info
NODE_ENV=development
API_PUBLIC_URL=/api
DB_POOL_SIZE=10
RATE_LIMIT_MAX=120
TRUST_PROXY=false
POSTGRES_BIND_ADDRESS=127.0.0.1

# Optional legacy administrator allowlists for Telegram-linked accounts.
ADMIN_USER_IDS=
ADMIN_TELEGRAM_IDS=
# Root/bootstrap credentials for the separate admin console. They always work and cannot be
# revoked there; other admins are added from the console's "Адміністратори" page.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Required in production for verification and password recovery emails.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_BREVO_SMTP_LOGIN
SMTP_PASSWORD=replace-with-brevo-smtp-key
SMTP_FROM=Constella <no-reply@your-verified-domain.example>

# Optional Error Monitoring (Sentry)
# API (Fastify) зчитує SENTRY_DSN; веб і мобілка — свої public-змінні (той самий
# фронтенд-проєкт). Порожні значення або placeholder повністю вимикають SDK.
SENTRY_DSN=
NUXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
PHOTO_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Mobile app (apps/mobile). EXPO_PUBLIC_* values are inlined into the JS bundle at
# build time, so by definition they are not secret; `expo start` reads them once.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
# EAS credentials for `eas build` / production export only — never EXPO_PUBLIC_*.
EXPO_ACCESS_TOKEN=
EXPO_PROJECT_ID=
# Expo key used by the API push fan-out (apps/api/src/push/notify.ts). When empty the
# API falls back to EXPO_ACCESS_TOKEN; with neither set, pushes are simply not sent.
EXPO_PUSH_ACCESS_TOKEN=

# Audio/video calls (LiveKit Cloud, apps/api/src/call/livekit.ts). Optional: with any
# of the three missing, social.callConfig reports calls unavailable and the web app
# hides the call buttons — nothing else in the API changes.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# wss:// endpoint the browser connects to. Only the API reads it and hands it back in
# the startCall/acceptCall response, so there is no NUXT_PUBLIC_ copy to keep in sync.
LIVEKIT_URL=

# Chat/call realtime delivery (Ably, apps/api/src/realtime/ably.ts). Optional: without
# it the API keeps pushing to in-process websockets only, and the web app polls its
# chat every 5s and hides the call buttons. Format appId.keyId:secret, API project only.
ABLY_API_KEY=
# Set to "sandbox" while testing with a key from an Ably sandbox app (those are only
# served by sandbox-rest.ably.io). Leave empty for a published app.
ABLY_ENVIRONMENT=

# Self-hosted inference service (the NSFW classifier on the dedicated AI box, called
# from apps/api/src/photos/moderation.ts). The service itself lives in ai/nsfw and is
# deployed with docker compose on that box — see ai/nsfw/README.md. Optional here: while
# AI_SERVICE_URL is empty the photo pipeline behaves exactly as it did before
# moderation — the upload is approved and recorded as provider "unmoderated". Once it
# is set, any failure of the service holds the photo as "pending" for the human review
# queue instead of approving it.
AI_SERVICE_URL=
# Shared secret with the service, at least 32 random characters; with it missing the
# service answers 401 and every photo lands in that same review queue.
AI_INTERNAL_TOKEN=
# Threshold on the model's porn+hentai sum. The sexy class alone never auto-rejects, it
# only sends the photo to review — swimwear scores high by design. Empty keeps the
# built-in 0.80 reject / 0.15 review / 0.35 sexy-review values.
AI_NSFW_REJECT_AT=
AI_NSFW_PENDING_AT=
AI_NSFW_SEXY_REVIEW_AT=
# Milliseconds for one classification call, no retries. Raise it only if the API's
# serverless function has the duration budget; empty means 3000.
AI_CLASSIFY_TIMEOUT_MS=
