# Local development defaults. Replace every placeholder before deployment.
DATABASE_URL=postgres://constella:constella_secret_password@localhost:5432/constella
POSTGRES_PASSWORD=constella_secret_password
BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-api-domain.example/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-32-character-webhook-secret
JWT_SECRET=replace-with-at-least-32-random-characters
PAYMENTS_INTERNAL_TOKEN=replace-with-a-different-random-secret-of-at-least-32-characters
WEB_APP_URL=https://your-public-https-domain.example
API_INTERNAL_URL=http://127.0.0.1:4000
NUXT_API_INTERNAL_BASE=http://127.0.0.1:4000
PORT=4000
LOG_LEVEL=info
NODE_ENV=development
API_PUBLIC_URL=/api
DB_POOL_SIZE=10
RATE_LIMIT_MAX=120
TRUST_PROXY=false
POSTGRES_BIND_ADDRESS=127.0.0.1

# Optional legacy administrator allowlists for Telegram-linked accounts.
ADMIN_USER_IDS=
ADMIN_TELEGRAM_IDS=
# Credentials for the separate web admin login; keep the password server-side.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Required in production for verification and password recovery emails.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_BREVO_SMTP_LOGIN
SMTP_PASSWORD=replace-with-brevo-smtp-key
SMTP_FROM=Constella <no-reply@your-verified-domain.example>

# Optional Error Monitoring (Sentry)
SENTRY_DSN=
PHOTO_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
