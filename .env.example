# Local development defaults. Replace every placeholder before deployment.
DATABASE_URL=postgres://constella:constella_secret_password@localhost:5432/constella
POSTGRES_PASSWORD=constella_secret_password
BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-api-domain.example/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-32-character-webhook-secret
JWT_SECRET=replace-with-at-least-32-random-characters
PAYMENTS_INTERNAL_TOKEN=replace-with-a-different-random-secret-of-at-least-32-characters
WEB_APP_URL=https://your-public-https-domain.example
API_INTERNAL_URL=http://127.0.0.1:4000
NUXT_API_INTERNAL_BASE=http://127.0.0.1:4000
# Landing site (apps/landing, dev server on :5174). Canonical host used for
# prerendered markup, hreflang, sitemap and RSS — replace with the real domain
# for any deployment; the deploy scripts ignore a localhost value here on purpose.
NUXT_PUBLIC_SITE_URL=http://localhost:5174
# t.me/<bot> username used by the landing and web calls to action.
NUXT_PUBLIC_BOT_USERNAME=replace-with-your-bot-username
PORT=4000
LOG_LEVEL=info
NODE_ENV=development
API_PUBLIC_URL=/api
DB_POOL_SIZE=10
RATE_LIMIT_MAX=120
TRUST_PROXY=false
POSTGRES_BIND_ADDRESS=127.0.0.1

# Optional legacy administrator allowlists for Telegram-linked accounts.
ADMIN_USER_IDS=
ADMIN_TELEGRAM_IDS=
# Credentials for the separate web admin login; keep the password server-side.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Required in production for verification and password recovery emails.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_BREVO_SMTP_LOGIN
SMTP_PASSWORD=replace-with-brevo-smtp-key
SMTP_FROM=Constella <no-reply@your-verified-domain.example>

# Optional Error Monitoring (Sentry)
SENTRY_DSN=
PHOTO_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Mobile app (apps/mobile). EXPO_PUBLIC_* values are inlined into the JS bundle at
# build time, so by definition they are not secret; `expo start` reads them once.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
# EAS credentials for `eas build` / production export only — never EXPO_PUBLIC_*.
EXPO_ACCESS_TOKEN=
EXPO_PROJECT_ID=
# Expo key used by the API push fan-out (apps/api/src/push/notify.ts). When empty the
# API falls back to EXPO_ACCESS_TOKEN; with neither set, pushes are simply not sent.
EXPO_PUSH_ACCESS_TOKEN=
