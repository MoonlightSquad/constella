{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "BOT_TOKEN",
    "TELEGRAM_WEBHOOK_SECRET",
    "JWT_SECRET",
    "PAYMENTS_INTERNAL_TOKEN",
    "ADMIN_TELEGRAM_IDS",
    "PHOTO_BUCKET",
    "S3_REGION",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_PUBLIC_BASE_URL",
    "S3_FORCE_PATH_STYLE",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "SMTP_FROM",
    "SENTRY_DSN",
    "SENTRY_ENVIRONMENT",
    "API_PUBLIC_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", ".output/**", ".vercel/output/**"],
      "env": [
        "WEB_APP_URL",
        "API_INTERNAL_URL",
        "API_PROXY_TARGET",
        "NUXT_API_INTERNAL_BASE",
        "NUXT_PUBLIC_API_URL",
        "NUXT_PUBLIC_APP_URL",
        "NUXT_PUBLIC_BOT_USERNAME",
        "NUXT_PUBLIC_SENTRY_DSN"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
