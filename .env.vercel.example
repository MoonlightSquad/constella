# ==============================================================================
# CONSTELLA · VERCEL ALL-IN-ONE ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
# Цей файл є шаблоном змінних оточення для розгортання проєкту на Vercel.
# Скопіюйте його у .env.vercel або імпортуйте змінні у Vercel Project Settings:
#   cp .env.vercel.example .env.vercel
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. VERCEL PROJECT SELECTION
# ------------------------------------------------------------------------------
# Optional: select a Vercel team by ID or slug (use one)
VERCEL_TEAM_ID=
VERCEL_SCOPE=
# Optional overrides; defaults are constella-api / constella-web / constella-landing and hosts below
VERCEL_API_PROJECT=constella-api
VERCEL_WEB_PROJECT=constella-web
VERCEL_LANDING_PROJECT=constella-landing
VERCEL_API_DOMAIN=api-test.constella.pp.ua
VERCEL_WEB_DOMAIN=app-test.constella.pp.ua
# The landing is a third, separate project: a Vercel project cannot serve two root directories.
# constella.pp.ua is its only host — there is no test twin, so a test run publishes the same domain.
VERCEL_LANDING_DOMAIN=constella.pp.ua

# ------------------------------------------------------------------------------
# 1. ЗАГАЛЬНІ НАЛАШТУВАННЯ (Runtime & Environment)
# ------------------------------------------------------------------------------
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. БАЗА ДАНИХ (Aiven PostgreSQL з увімкненим розширенням PostGIS)
# ------------------------------------------------------------------------------
# Отримайте рядок підключення (Service URI) у кабінеті aiven.io
DATABASE_URL=postgres://avnadmin:YOUR_AIVEN_PASSWORD@pg-service-name.aivencloud.com:15432/defaultdb?sslmode=require

# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT (Токен та Адміністратори)
# ------------------------------------------------------------------------------
# Створіть бота в @BotFather та скопіюйте токен і юзернейм
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER
BOT_USERNAME=constella_dating_bot
TELEGRAM_WEBHOOK_URL=https://api-test.constella.pp.ua/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-32-character-webhook-secret

# Числові Telegram ID адміністраторів через кому (дізнатися можна в @userinfobot)
ADMIN_TELEGRAM_IDS=123456789
# Admin login credentials (plain Vercel project configuration; API project only).
# Set these values in the ignored .env.vercel file, then run `pnpm vercel:env api`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 4. ДОМЕНИ ТА МАРШРУТИЗАЦІЯ (Vercel Subdomain Architecture)
# ------------------------------------------------------------------------------
# Фронтенд (Mini App + Web): https://app-test.constella.pp.ua
# Бекенд (Serverless API + tRPC): https://api-test.constella.pp.ua
# Лендінг (маркетинг + блог): https://constella.pp.ua
# NUXT_PUBLIC_APP_URL і NUXT_PUBLIC_BOT_USERNAME нижче вживає і лендінг — власних
# замін для нього немає.
WEB_APP_URL=https://app-test.constella.pp.ua
NUXT_PUBLIC_BOT_USERNAME=constella_dating_bot
NUXT_PUBLIC_APP_URL=https://app-test.constella.pp.ua
NUXT_PUBLIC_API_URL=https://api-test.constella.pp.ua
API_PROXY_TARGET=https://api-test.constella.pp.ua
API_INTERNAL_URL=https://api-test.constella.pp.ua
# Canonical host лендінгу: він уходить у prerender-HTML, hreflang, sitemap і RSS,
# тож має точно збігатися з доменом проєкту. Зміна потребує ребілда.
NUXT_PUBLIC_SITE_URL=https://constella.pp.ua
# База для nitro-проксі (/api/blog/*, /api/admin/*). Виклик іде server-to-server,
# тому дозволений CORS origin API (один — вебзастосунок) не зачіпається.
NUXT_API_INTERNAL_BASE=https://api.constella.pp.ua

# ------------------------------------------------------------------------------
# 5. КРИПТОГРАФІЧНІ СЕКРЕТИ (Security & Sessions)
# ------------------------------------------------------------------------------
# 32+ значні випадкові HEX-ключі (автоматично генеруються командою `pnpm config:sync`)
JWT_SECRET=your_32_byte_hex_jwt_secret_key_here_for_user_sessions
PAYMENTS_INTERNAL_TOKEN=your_32_byte_hex_payments_internal_token_here_for_bot_api

# ------------------------------------------------------------------------------
# 6. СХОВИЩЕ МЕДІА ТА ГОЛОСОВИХ (Cloudflare R2 / S3)
# ------------------------------------------------------------------------------
# Налаштуйте R2 бакет у dash.cloudflare.com
PHOTO_BUCKET=constella-media
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
S3_PUBLIC_BASE_URL=https://pub-yourbucketid.r2.dev
S3_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------------------
# 7. ТРАНЗАКЦІЙНА ПОШТА (Resend / SMTP)
# ------------------------------------------------------------------------------
# Отримайте API-ключ у resend.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key_here
SMTP_FROM=Constella Support <support@test.constella.pp.ua>

# ------------------------------------------------------------------------------
# 8. МОНІТОРИНГ ПОМИЛОК (Sentry)
# ------------------------------------------------------------------------------
# Створіть проєкти на sentry.io та вкажіть DSN
SENTRY_DSN=https://public_key@o000000.ingest.sentry.io/0000000
NUXT_PUBLIC_SENTRY_DSN=https://public_key@o000000.ingest.sentry.io/0000000
# мобільний білд (EAS) використовує той самий фронтенд-проєкт Sentry
EXPO_PUBLIC_SENTRY_DSN=https://public_key@o000000.ingest.sentry.io/0000000
SENTRY_ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 9. МОБІЛЬНИЙ ЗАСТОСУНОК (apps/mobile — Expo + React Native)
# ------------------------------------------------------------------------------
# На Vercel мобільного немає: збірку робить EAS (`eas build`), тому EXPO_ACCESS_TOKEN
# і EXPO_PROJECT_ID належать EAS-проєкту. EXPO_PUBLIC_API_URL вбудовується прямо у
# бандл — секретів у ньому бути не може, і зміна вимагає нової збілки.
EXPO_PUBLIC_API_URL=https://api-test.constella.pp.ua
EXPO_ACCESS_TOKEN=
EXPO_PROJECT_ID=
# EXPO_PUSH_ACCESS_TOKEN — це вже змінна API-проєкту (apps/api/src/push/notify.ts):
# без неї, як і без EXPO_ACCESS_TOKEN, пуші просто не надсилаються, уся решта працює.
EXPO_PUSH_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 10. ДЗВІНКИ (LiveKit Cloud)
# ------------------------------------------------------------------------------
# Змінні лише API-проєкту: браузер підключається до LIVEKIT_URL напряму (wss), тому
# копії в NUXT_PUBLIC_* не потрібні — `social.callConfig` повертає url із сервера.
# Без будь-якого з цих значень `social.startCall` повертає PRECONDITION_FAILED, а
# веб-застосунок ховає кнопки дзвінка. Створюється безкоштовний «Build»-проєкт на
# cloud.livekit.io; TURN і медіа-сервери на боці провайдера, свого SFU не треба.
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud
