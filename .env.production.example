# ==============================================================================
# CONSTELLA PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.production (or load into your secret manager / hosting environment).
# Ensure all required secrets are replaced with cryptographically secure values.
# ==============================================================================

NODE_ENV=production

# Database (PostgreSQL + PostGIS)
# When using docker-compose.production.yml:
# - POSTGRES_PASSWORD is used by the postgres container.
# - DATABASE_URL points to the postgres container inside the private docker network.
POSTGRES_PASSWORD=replace-with-strong-db-password-at-least-24-chars
DATABASE_URL=postgres://constella:replace-with-strong-db-password-at-least-24-chars@postgres:5432/constella
DB_POOL_SIZE=10

# Telegram Bot
# Real bot token obtained from @BotFather
BOT_TOKEN=replace-with-your-telegram-bot-token

# Public Application URL (Must be HTTPS for Telegram Mini App)
WEB_APP_URL=https://your-public-https-domain.example

# Security Secrets (Must be at least 32 random characters each, different from each other)
JWT_SECRET=replace-with-at-least-32-random-characters-for-jwt-secret
PAYMENTS_INTERNAL_TOKEN=replace-with-at-least-32-random-characters-for-internal-payments

# API and Network Settings
PORT=4000
API_PUBLIC_URL=/api
RATE_LIMIT_MAX=120
# Set TRUST_PROXY to true or specific IP/CIDR if behind Nginx/Cloudflare/Traefik
TRUST_PROXY=false
LOG_LEVEL=info

# Service discovery for internal communications
API_INTERNAL_URL=http://api:4000
NUXT_API_INTERNAL_BASE=http://api:4000
NITRO_HOST=0.0.0.0
NITRO_PORT=3000
WEB_PORT=3000

# Admin Access Allowlist (Comma-separated Telegram numeric IDs and/or user UUIDs)
ADMIN_USER_IDS=
ADMIN_TELEGRAM_IDS=

# Transactional Email (SMTP relay for verification & password recovery)
# Recommended free/starter provider: Resend (SMTP) or Brevo
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASSWORD=replace-with-smtp-api-key
SMTP_FROM=Constella <no-reply@your-domain.example>

# S3-Compatible Object Storage for Profile Photos
PHOTO_BUCKET=constella-photos
S3_REGION=eu-central-1
# S3_ENDPOINT is optional; leave empty for standard AWS S3, or set for Cloudflare R2 / MinIO / DigitalOcean Spaces
S3_ENDPOINT=
S3_ACCESS_KEY_ID=replace-with-s3-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-access-key
S3_PUBLIC_BASE_URL=https://cdn.your-domain.example


# Optional Error Monitoring (Sentry)
SENTRY_DSN=
