{
  "expo": {
    "name": "Constella",
    "slug": "constella-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "constella",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101c1d",
    "ios": {
      "bundleIdentifier": "pp.constella.mobile",
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Constella показує знайомства поблизу — потрібен ваш приблизний населений пункт.",
        "NSPhotoLibraryUsageDescription": "Ви обираєте фото профію зі своєї галереї.",
        "NSCameraUsageDescription": "Ви можете зробити фото для профію або в чат просто в застосунку.",
        "NSMicrophoneUsageDescription": "Ви записуєте голосові повідомлення в чаті."
      }
    },
    "android": {
      "package": "pp.constella.mobile",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-asset",
      "@sentry/react-native",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101c1d",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#d9b879"
        }
      ],
      "expo-image-picker",
      "expo-video",
      "expo-font",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://api.constella.pp.ua",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "95d5c1ca-eb93-4b54-a76f-9e250019107e"
      }
    },
    "owner": "constelladatings-team"
  }
}
