{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nuxtjs",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS, PATCH" },
        { "key": "Access-Control-Allow-Headers", "value": "X-Requested-With, Content-Type, Accept, Authorization, x-telegram-init-data, x-payments-token" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    {
      "has": [
        {
          "type": "host",
          "value": "api-test.constella.pp.ua"
        }
      ],
      "source": "/trpc/(.*)",
      "destination": "/api/trpc/$1"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "api-test.constella.pp.ua"
        }
      ],
      "source": "/telegram/(.*)",
      "destination": "/api/telegram/$1"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "api-test.constella.pp.ua"
        }
      ],
      "source": "/health/(.*)",
      "destination": "/api/health/$1"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "api-test.constella.pp.ua"
        }
      ],
      "source": "/cron/(.*)",
      "destination": "/api/cron/$1"
    },
    {
      "source": "/trpc/(.*)",
      "destination": "/api/trpc/$1"
    }
  ]
}
