{
  "name": "@constella/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "test": "tsx --test src/utils/*.test.ts src/payments/*.test.ts src/photos/*.test.ts src/engine/*.test.ts src/routers/*.test.ts src/trpc.test.ts ../../packages/shared/src/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@constella/bot": "workspace:*",
    "@constella/db": "workspace:*",
    "@constella/shared": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@trpc/server": "^11.19.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.31.4",
    "fastify": "^4.27.0",
    "nodemailer": "^10.0.16",
    "sharp": "^0.35.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  }
}
