# API reads the shared repository-root .env by default. These are the API variables.
DATABASE_URL=postgres://constella:constella_secret_password@localhost:5432/constella
BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-32-character-webhook-secret
JWT_SECRET=replace-with-at-least-32-random-characters
PAYMENTS_INTERNAL_TOKEN=replace-with-a-different-random-secret-of-at-least-32-characters
WEB_APP_URL=https://your-public-https-domain.example
API_INTERNAL_URL=http://127.0.0.1:4000
PORT=4000
LOG_LEVEL=info
NODE_ENV=development
API_PUBLIC_URL=/api
DB_POOL_SIZE=10
RATE_LIMIT_MAX=120
TRUST_PROXY=false
POSTGRES_BIND_ADDRESS=127.0.0.1

# Comma-separated user UUIDs or Telegram numeric IDs allowed to use /admin. Leave empty to disable admin access.
ADMIN_USER_IDS=
ADMIN_TELEGRAM_IDS=

# Required in production for verification and password recovery emails.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASSWORD=replace-with-resend-api-key
SMTP_FROM=Constella <no-reply@your-verified-domain.example>

# S3-compatible photo storage; grant the API Put/Get/Head/Delete only on this bucket.
PHOTO_BUCKET=constella-photos
S3_REGION=eu-central-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://cdn.example.com
