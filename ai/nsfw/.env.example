# Копіюйте в .env на AI-boxі: docker compose читає .env з цього ж каталогу.
# Це локальний файл бокса — у Vercel він не потрібен, там лише AI_SERVICE_URL +
# AI_INTERNAL_TOKEN з того самого секрету.

# Той самий секрет, що й в API-проєкті Vercel (>= 32 символи). Без нього сервіс
# навмисно не стартує: інакше це безкоштовний публічний класифікатор.
AI_INTERNAL_TOKEN=

# Публічний hostname, на який API вказує AI_SERVICE_URL (A-запис на цю машину).
AI_HOSTNAME=ai.example.com
# Опційно: електронка для ACME-нагадувань. Розкоментуйте `tls` у Caddyfile лише
# разом із заповненим ACME_EMAIL: порожнє значення лишає `tls` без аргументу і
# Caddy не стартує.
ACME_EMAIL=

# Джерело ваг: hf = експорт з apache-2.0 моделі + перевірку проти transformers-еталону
# (продакшен), hub-onnx = чужий готовий ONNX (швидше, без torch, потребує SHA256).
MODEL_SOURCE=hf
MODEL_QUANT=int8
HUB_ONNX_SHA256=
# Порожнє значення = PyPI (потрібно на aarch64, де CPU-варіанти torch вже там).
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

IMAGE_TAG=local
# Третє ядро лишаємо на decode/Caddy/OS; 4g з запасом для int8 ViT-Base.
AI_INTRA_OP_THREADS=2
NSFW_MEMORY_LIMIT=4g
AI_MAX_BODY_BYTES=16777216
AI_QUEUE_TIMEOUT_MS=700
